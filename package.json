{
  "name": "hr-admin-agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "shared",
    "web"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:one": "node scripts/test-one.mjs",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config server/vitest.integration.config.ts",
    "build": "npm run build --workspaces --if-present",
    "seed": "node --env-file-if-exists=.env --import tsx server/src/seeds/cli.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "evals": "node --env-file-if-exists=.env --import tsx server/src/evals/cli.ts",
    "e2e": "playwright test",
    "e2e:server": "node --env-file-if-exists=.env --import tsx server/src/e2e/main.ts",
    "e2e:record": "E2E_MODEL=record playwright test",
    "dev-metrics": "node --import tsx scripts/dev-metrics.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  }
}
