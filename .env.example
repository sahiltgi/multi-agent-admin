# Copy to .env and fill in locally. Never commit real values.
NODE_ENV=development
PORT=3000
# Optional: override the leave policy file (default policies/leave/v1.yaml). The file stem must match its version.
# LEAVE_POLICY_PATH=

# MongoDB (docker-compose.yml)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/hr?authSource=admin

# Claude API
ANTHROPIC_API_KEY=

# Web
VITE_API_BASE_URL=http://localhost:3000
